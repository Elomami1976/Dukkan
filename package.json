{
  "name": "dukkan-business-manager",
  "version": "1.1.0",
  "private": true,
  "description": "نظام Dukkan لإدارة الأعمال والمبيعات لنشاطك في ليبيا",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build --configLoader runner",
    "preview": "vite preview",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.mjs",
    "tauri": "tauri",
    "lint": "node ./node_modules/eslint/bin/eslint.js src",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "test:migrations": "node ./scripts/check-migrations.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
